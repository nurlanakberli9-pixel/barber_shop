# Nümunədir. Real dəyərlər platformanın Environment/Secrets bölməsinə yazılır, GitHub-a yox.
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://HOST:5432/DBNAME?sslmode=require
DB_USER=
DB_PASSWORD=
DB_POOL_SIZE=5
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.tld
# Yalnız lokal docker compose üçün:
POSTGRES_PASSWORD=change-me
